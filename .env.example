# Copia este archivo a .env y llena los valores. NUNCA subas .env al repositorio.

# Base de datos MySQL
DB_URL=jdbc:mysql://localhost:3306/pey_backend?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=cambia-esto

# API de Pey (https://docs.pey.mx). La API key se crea en el portal de Pey.
PEY_API_KEY=tu-api-key-de-pey
PEY_API_URL=https://api.pey.mx
# Vigencia del QR de CoDi en segundos (20 minutos)
QR_EXPIRATION_SECONDS=1200

# JWT del panel de admin. Usa un secreto largo y aleatorio en Base64 (minimo 32 bytes para HS256).
JWT_SECRET=genera-un-secreto-base64-largo-y-aleatorio
# Expiracion del token en milisegundos (3600000 = 1 hora)
JWT_EXPIRATION=3600000

# Admin inicial (lo crea GuardiaBot al arrancar si no existe)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto

# Origenes permitidos para CORS, separados por comas
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
