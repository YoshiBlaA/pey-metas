# Copia este archivo a .env y llena los valores. NUNCA subas .env al repositorio.

# Base de datos MySQL
DB_URL=jdbc:mysql://localhost:3306/pey_backend?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=cambia-esto

# API de Pey (https://docs.pey.mx). La API key se crea en el portal de Pey.
PEY_API_KEY=tu-api-key-de-pey
PEY_API_URL=https://api.pey.mx
# Vigencia del QR de CoDi en segundos (20 minutos). Pey exige minimo 360.
QR_EXPIRATION_SECONDS=1200
# Opcionales del cliente de Pey
# true = Pey regresa qrImage (PNG base64), mas lento; false = el front dibuja el QR con qrString
PEY_GENERATE_IMAGE=false
PEY_CONNECT_TIMEOUT_MS=5000
PEY_READ_TIMEOUT_MS=30000

# Opcionales: tarea que marca expiradas las aportaciones PENDING vencidas (milisegundos)
WEBHOOK_EXPIRATION_JOB_DELAY_MS=60000
WEBHOOK_EXPIRATION_JOB_INITIAL_DELAY_MS=60000

# Webhook de Pey (firma Standard Webhooks)
# Secreto del webhook (whsec_...) que muestra el portal de Pey al crear el webhook
# (Desarrollador -> engrane de la API key). Sin el, todo webhook responde 401 y no se registra ningun pago.
# Para pruebas locales puedes generar uno propio en PowerShell:
#   'whsec_' + [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
PEY_WEBHOOK_SECRET=whsec_tu-secreto
# Solo desarrollo: true acepta webhooks sin firma cuando PEY_WEBHOOK_SECRET esta vacio. Nunca en produccion.
PEY_WEBHOOK_ALLOW_UNSIGNED=false
# Diferencia maxima en segundos entre webhook-timestamp y la hora del servidor
PEY_WEBHOOK_TOLERANCE_SECONDS=300

# JWT del panel de admin. OBLIGATORIO: secreto aleatorio de minimo 32 bytes, de preferencia Base64.
# Generalo en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# o en Linux/macOS: openssl rand -base64 48
JWT_SECRET=
# Expiracion del token en milisegundos (3600000 = 1 hora)
JWT_EXPIRATION=3600000

# Admin inicial: se crea al arrancar si no existe y si ADMIN_PASSWORD no esta vacio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto

# Origenes permitidos para CORS, separados por comas. Acepta patrones como https://*.vercel.app
# o * (cualquier origen; recomendado SOLO para desarrollo, en produccion lista los dominios del front)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
